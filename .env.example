# Optional HTTP port (defaults to 3000).
PORT=3000
# Optional MongoDB connection URI (defaults to this local database).
MONGODB_URI=mongodb://127.0.0.1:27017/triplite
# Required: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
SESSION_SECRET=
# Set to the number of trusted reverse-proxy hops in production; leave 0 for direct local access.
TRUST_PROXY_HOPS=0
